# Dados sensíveis de saúde — nunca versionar dados reais/brutos.
# Mantemos apenas a pasta rastreada via .gitkeep; qualquer CSV real
# deve ser adicionado localmente e nunca commitado (LGPD).
data/raw/*.csv
!data/raw/.gitkeep